# Environment variables - copy to .env and fill values
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/db
GOOGLE_API_KEY=your-google-api-key
GOOGLE_TTS_CREDENTIALS_PATH=./credentials.json
OBSIDIAN_FOLDER_PATH=../obsidian-test
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
GROQ_API_KEY=your-groq-api-key-here
# Chat fallback model when the OmniRoute gateway is unreachable
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# OmniRoute LLM gateway (all LLM chat + embeddings go through it;
# key can also be pasted in the app under Settings → LLM)
OMNIROUTER_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTER_API_KEY=your-omniroute-api-key
OMNIROUTER_CHAT_MODEL=tokenharbor/deepseek-v4.1-flash:free
OMNIROUTER_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
# Active profile: "server" or "local". Both profiles are also editable and
# switchable in Settings → LLM; the DB values override these defaults.
OMNIROUTER_PROVIDER=server
# Local OmniRoute profile (separate URL/key/models)
OMNIROUTER_LOCAL_BASE_URL=http://host.docker.internal:20128/v1
OMNIROUTER_LOCAL_API_KEY=local
OMNIROUTER_LOCAL_CHAT_MODEL=fast_trans
OMNIROUTER_LOCAL_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
# Single shared app password (leave empty = no password gate).
# Generate a hash: cd backend && python -m app.utils.password "your-password"
APP_PASSWORD_HASH=
